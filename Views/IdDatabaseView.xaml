<UserControl x:Class="FsLocalizationPlugin.Views.IdDatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Frosty.Core.Controls;assembly=FrostyCore"
             xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
             xmlns:controls="clr-namespace:FsLocalizationPlugin.Controls"
             mc:Ignorable="d"
             UseLayoutRounding="False"
             FontFamily="Segoe UI Variable Text, Global User Interface"
             d:DesignHeight="800" d:DesignWidth="1350">
  <!-- View model: ViewModels/IdDatabaseViewModel.cs. Hosted in a tab by Controls/IdDatabaseEditor.cs. -->

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/FsLocalizationPlugin;component/Themes/Generic.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis"/>

      <!-- FrostyAssetListView style DataGrid -->
      <Style x:Key="IdDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FontColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4, 2, 4, 2"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="IdDataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource FontColor}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
              <Grid>
                <!-- The separator sits on the LEFT of each header, so the last column
                     does not draw a stray line against the right edge of the grid. -->
                <Border x:Name="headerBorder" Background="{StaticResource ControlBackground}" Height="22" Padding="4, 0, 2, 0"
                        BorderBrush="{StaticResource ListBackground}" BorderThickness="1, 0, 0, 0">
                  <DockPanel LastChildFill="True">
                    <Path x:Name="sortArrow" DockPanel.Dock="Right" StrokeThickness="1" Fill="{StaticResource FontColor}"
                          VerticalAlignment="Center" Margin="2, 0, 4, 4" Visibility="Collapsed"
                          Data="M 5,5 L 10,10 L 15,5 L 5,5"/>
                    <ContentPresenter VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <!-- Invisible thumb, only provides the resize grip. -->
                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Cursor="SizeWE">
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border Background="Transparent"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                  <Setter TargetName="sortArrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                  <Setter TargetName="sortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="sortArrow" Property="Data" Value="M 5,10 L 15,10 L 10,5 L 5,10"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="headerBorder" Property="Background" Value="{StaticResource ControlPressed}"/>
                </Trigger>
                <!-- No separator before the first column. -->
                <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                  <Setter TargetName="headerBorder" Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <!-- The filler header right of the last column: no separator, nothing to resize. -->
                <DataTrigger Binding="{Binding Column, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                  <Setter TargetName="headerBorder" Property="BorderThickness" Value="0"/>
                  <Setter TargetName="PART_RightHeaderGripper" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid Template -->
      <Style x:Key="IdDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGrid}">
              <Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="DG_ScrollViewer" Grid.Row="0" Focusable="False" Padding="{TemplateBinding Padding}"
                              CanContentScroll="True">
                  <ScrollViewer.Template>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                      <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- The header strip is inset by 1 and the rows by Padding, the same
                             mismatch FrostyAssetListView has, because it reads well: the headers
                             look like they float over a slightly narrower list.
                             Columns are sized against the ROWS' width, so the header strip has a
                             few pixels spare at the right end. The DataGrid fills those with its
                             filler header, which this style paints like any other header, so the
                             strip still looks continuous. Unlike FrostyAssetListView nothing
                             overflows: star columns can only ever add up to the rows' width. -->
                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Row="0" Grid.Column="0" Margin="1"
                                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                KeyboardNavigation.DirectionalNavigation="Local"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>

                        <!-- Spans both rows, so it fills the corner beside the headers. -->
                        <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="-1, 0, 0, 0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                      </Grid>
                    </ControlTemplate>
                  </ScrollViewer.Template>
                  <ItemsPresenter/>
                </ScrollViewer>

                <Border Grid.Row="1" Background="{TemplateBinding BorderBrush}"
                        Height="{Binding BorderThickness.Bottom, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="IdDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource SubItemHighlight}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource SubItemPressed}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <DataTemplate x:Key="HashCellTemplate">
        <controls:RevisedHighlightTextBlock SourceText="{Binding HashHex, Mode=OneWay}"
                                     Highlight="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                     FontFamily="Consolas, monospace" Foreground="{StaticResource FontColor}"/>
      </DataTemplate>
      <DataTemplate x:Key="IdCellTemplate">
        <controls:RevisedHighlightTextBlock SourceText="{Binding Id, Mode=OneWay}"
                                     Highlight="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                     TextWrapping="Wrap" Foreground="{StaticResource FontColor}"/>
      </DataTemplate>

    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{StaticResource ControlBackground}">
    <Grid Margin="2" Background="{StaticResource ListBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="7.5*"/>
        <RowDefinition Height="2.5*"/>
      </Grid.RowDefinitions>

      <!-- Toolbar -->
      <Border Grid.Row="0" BorderBrush="{StaticResource ControlBackground}" BorderThickness="0, 2, 0, 2"
              Background="{StaticResource ListBackground}">
        <WrapPanel Orientation="Horizontal" Margin="0, 0, 1, 1">
          <!-- Inspiration from: https://github.com/CommunityToolkit/Windows/tree/main/components/Segmented -->
          <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                  Padding="2" Margin="1, 1, 0, 0"
                  Background="{StaticResource ControlBackground}"
                  Visibility="{Binding IsProjectDatabaseEnabled, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
              <RadioButton GroupName="DatabaseView" IsChecked="{Binding IsCachedView, Mode=TwoWay}" d:IsChecked="True"
                           Style="{StaticResource SegmentedItem}" Padding="6, 3, 6, 3">
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Database.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Cached Database"/>
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="DatabaseView" IsChecked="{Binding IsProjectView, Mode=TwoWay}"
                           Style="{StaticResource SegmentedItem}" Padding="6, 3, 6, 3">
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyCore;component/Images/Assets/BlankFileType.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Project Database"/>
                </StackPanel>
              </RadioButton>
            </WrapPanel>
          </Border>

          <Border Background="{StaticResource ControlBackground}"
                  Margin="1, 1, 0, 0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <WrapPanel Orientation="Horizontal"
                       Margin="2">
              <Button Padding="6, 3, 6, 3" Width="Auto"
                      Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Margin="0, 1, 5, 0" Text="&#xE72C;"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Refresh"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </Border>

          <Border Background="{StaticResource ControlBackground}"
                  Margin="1, 1, 0, 0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <WrapPanel Orientation="Horizontal"
                       Margin="2">
              <ToggleButton x:Name="AddIdToggleButton" Padding="6, 3, 6, 3" Width="Auto" d:IsChecked="False">
                <StackPanel Orientation="Horizontal">
                  <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Style.Triggers>
                        <!-- ToggleButton.Style cannot be overwritten -->
                        <DataTrigger Binding="{Binding IsChecked, ElementName=AddIdToggleButton}" Value="True">
                          <Setter Property="Margin" Value="-1"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyCore;component/Images/Add.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Add ID"/>
                </StackPanel>
              </ToggleButton>

              <Popup x:Name="AddIdPopup" Height="Auto" MaxHeight="850" MinWidth="300" Width="Auto" MaxWidth="400" KeyDown="Popup_KeyDown"
                     IsOpen="{Binding IsChecked, ElementName=AddIdToggleButton}" StaysOpen="False" d:IsOpen="True"
                     PlacementTarget="{Binding ElementName=AddIdToggleButton}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Slide">
                <!-- A Popup is its own visual tree and does not inherit the DataContext. -->
                <Border DataContext="{Binding DataContext, ElementName=AddIdToggleButton}" RenderOptions.EdgeMode="Aliased"
                        Background="{StaticResource ListBackground}" BorderBrush="{StaticResource ControlBackground}" BorderThickness="1">
                  <Grid Margin="5">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="3">
                      <Label Width="Auto" Target="{Binding ElementName=AddIdHashBox}">
                        <Label.Content>
                          <StackPanel Orientation="Horizontal">
                            <Image Margin="0, 1, 5, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/tag_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz24.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <AccessText Foreground="{StaticResource FontColor}" Text="_Hash: "/>
                          </StackPanel>
                        </Label.Content>
                      </Label>
                      <TextBox x:Name="AddIdHashBox" Padding="2.5" Margin="2" Width="Auto" MinWidth="65"
                               BorderThickness="1"
                               Text="{Binding AddIdHashText, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsTab="False"
                               AcceptsReturn="False"
                               AutoWordSelection="False"
                               VerticalScrollBarVisibility="Disabled"
                               HorizontalScrollBarVisibility="Disabled"
                               FontFamily="Consolas, monospace"
                               d:Text="F1A88E22"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="3">
                      <Label Width="Auto" Target="{Binding ElementName=AddIdIdBox}">
                        <Label.Content>
                          <StackPanel Orientation="Horizontal">
                            <Image Margin="0, 1, 5, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/label_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz24.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <AccessText Foreground="{StaticResource FontColor}" Text="_ID: "/>
                          </StackPanel>
                        </Label.Content>
                      </Label>
                      <TextBox x:Name="AddIdIdBox" Padding="2.5" Margin="2" Width="Auto" MinWidth="100" Height="Auto" MaxHeight="100"
                               BorderThickness="1"
                               Text="{Binding AddIdIdText, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsTab="False"
                               AcceptsReturn="False"
                               AutoWordSelection="False"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               TextWrapping="Wrap"
                               d:Text="ID_TEST1111111111"/>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <Label Padding="5, 5, 0, 5">
                          <Label.Content>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Margin="0, 1, 5, 0" Text="&#xE7B3;"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                         RenderOptions.BitmapScalingMode="HighQuality"/>
                              <TextBlock Foreground="{StaticResource FontColor}">
                                <TextBlock.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontWeight" Value="Regular"/>
                                    <Setter Property="Text" Value="Current String Value: "/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding AddIdIsModified}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Text" Value="Current String Value*: "/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Label.Content>
                        </Label>
                        <!-- Status label wraps, so the full error message is always readable. -->
                        <Label Visibility="{Binding AddIdHasStatus, Converter={StaticResource BoolToVis}}" d:Visibility="Visible">
                          <Label.Content>
                            <TextBlock Foreground="{StaticResource FontColor}" TextWrapping="Wrap"
                                       Text="{Binding AddIdStatusMessage}" d:Text="Invalid Hash"/>
                          </Label.Content>
                        </Label>
                      </WrapPanel>

                      <!-- String value preview is NoWrap -->
                      <TextBlock Grid.Column="1" Padding="5" Foreground="{StaticResource FontColor}"
                                 Text="{Binding AddIdStringValue, Mode=OneWay}"
                                 Visibility="{Binding AddIdHasStringValue, Converter={StaticResource BoolToVis}}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <DockPanel Grid.Column="0" Margin="5" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Margin="0, 3, 5, 0" Text="&#xE946;" VerticalAlignment="Top"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding AddIdTargetMessage}" TextWrapping="WrapWithOverflow" Foreground="{StaticResource FontColor}"
                                   d:Text="This ID will be added to the project database."/>
                      </DockPanel>
                      <Button Grid.Column="1" Padding="6, 3, 6, 3" Margin="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="Auto"
                              Command="{Binding AddIdConfirmCommand}" IsDefault="True">
                        <Button.Content>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0, 1, 5, 0" Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            <AccessText Foreground="{StaticResource FontColor}" Text="_Confirm"/>
                          </StackPanel>
                        </Button.Content>
                      </Button>
                    </Grid>
                  </Grid>
                </Border>
              </Popup>

              <Button Padding="6, 3, 6, 3" Width="Auto"
                      Command="{Binding RemoveIdCommand}"
                      ToolTip="Forget the selected row.">
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Remove.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Remove ID"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </Border>

          <Border Background="{StaticResource ControlBackground}"
                  Margin="1, 1, 0, 0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsCachedView, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal" Margin="2">
              <Button Padding="6, 3, 6, 3" Width="Auto"
                      Command="{Binding ScanCommand}"
                      ToolTip="Search across whole game for string IDs. Takes a long time.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Margin="0, 1, 5, 0" Text="&#xE721;"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Scan Game Files"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </Border>

          <Border Background="{StaticResource ControlBackground}"
                  Margin="1, 1, 0, 0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <WrapPanel Orientation="Horizontal" Margin="2">
              <Button Padding="6, 3, 6, 3"
                      Command="{Binding ImportCommand}"
                      ToolTip="Merge a ID database file into this one, auto detects Cached or Project.">
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Import.png"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Import IDs File"/>
                </StackPanel>
              </Button>
              <Button Padding="6, 3, 6, 3"
                      Command="{Binding LocateCacheCommand}"
                      ToolTip="Locate the Cached ID database for sharing."
                      Visibility="{Binding IsCachedView, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Open.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Locate Cache File"/>
                </StackPanel>
              </Button>
              <Button Padding="6, 3, 6, 3"
                      Command="{Binding ExportProjectCommand}"
                      Visibility="{Binding IsProjectView, Converter={StaticResource BoolToVis}}"
                      ToolTip="Export the Project ID database for sharing.">
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Export.png"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="E_xport Project IDs"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </Border>

          <Border Background="{StaticResource ControlBackground}"
                  Margin="1, 1, 0, 0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsCachedView, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal" Margin="2">
              <Button Padding="6, 3, 6, 3"
                      Command="{Binding ComputeCommand}"
                      ToolTip="Compute an ID from a hash with GPU acceleration.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Margin="0, 1, 5, 0" Text="&#xE950;"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock Foreground="{StaticResource FontColor}" Text="Compute ID (WIP)"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </Border>

          <Border Background="{StaticResource ControlBackground}"
                  Margin="1, 1, 0, 0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <WrapPanel Orientation="Horizontal" Margin="2">
              <Label Padding="6, 3, 6, 3" Content="{Binding CountText}" d:Content="13000 of 21000 strings resolved"/>
            </WrapPanel>
          </Border>
        </WrapPanel>
      </Border>

      <StackPanel Grid.Row="1" Margin="0, 0, 0, 1">
        <Border Margin="1, 1, 1, 0" BorderBrush="{StaticResource ControlBackground}" BorderThickness="1">
          <!-- FrostyWatermarkTextBox's built-in border set SnapsToDevicePixels="True", which makes it looks weird.
               Use a individual border instead of it's own. -->
          <ctrl:FrostyWatermarkTextBox Height="24" Padding="4, 0, 0, 0"
                                       AutomationProperties.Name="Filter"
                                       BorderThickness="0" SnapsToDevicePixels="False"
                                       HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                       Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                       WatermarkText="Filter by Hash or ID"
                                       KeyDown="FilterBox_KeyDown"/>
        </Border>
        <ProgressBar Margin="1, -1, 1, 0" HorizontalAlignment="Stretch" Height="1" IsIndeterminate="True"
                     Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVis}}" d:Visibility="Visible"/>
      </StackPanel>

      <!-- Main list -->
      <DataGrid Grid.Row="2" AutomationProperties.Name="String IDs"
                Style="{StaticResource IdDataGridStyle}"
                Padding="4"
                ItemsSource="{Binding RowsView}"
                SelectedItem="{Binding SelectedRow}"
                Background="{StaticResource ListBackground}"
                Foreground="{StaticResource FontColor}"
                BorderBrush="{StaticResource ControlBackground}"
                BorderThickness="0"
                Margin="0, -1, 0, 3"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                RowHeaderWidth="0"
                GridLinesVisibility="None"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                CanUserResizeRows="False"
                ColumnHeaderStyle="{StaticResource IdDataGridHeaderStyle}"
                CellStyle="{StaticResource IdDataGridCellStyle}"
                RowStyle="{StaticResource IdDataGridRowStyle}"
                EnableRowVirtualization="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                VerticalScrollBarVisibility="Auto" d:VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTemplateColumn SortMemberPath="HashHex" Width="Auto" CellTemplate="{StaticResource HashCellTemplate}">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal">
                <Image Margin="0, 1, 4, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/tag_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz24.png"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Foreground="{StaticResource FontColor}" Text="Hash"/>
              </StackPanel>
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn SortMemberPath="Id" Width="6*" CellTemplate="{StaticResource IdCellTemplate}">
            <DataGridTemplateColumn.Header>
              <StackPanel Orientation="Horizontal">
                <Image Margin="0, 1, 4, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/label_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz24.png"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Foreground="{StaticResource FontColor}" Text="ID"/>
              </StackPanel>
            </DataGridTemplateColumn.Header>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Row="2" Background="{StaticResource ControlBackground}" Opacity="0.25" Margin="1, 0, 1, 3"
              Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVis}}" d:Visibility="Collapsed">
        <Grid>
          <TextBlock Foreground="{StaticResource FontColor}"
                     Text="Filter in Progress"
                     FontFamily="Segoe UI Variable Display, Global User Interface"
                     FontSize="70"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{StaticResource ControlBackground}"/>

      <!-- Detail area for the selected row-->
      <Grid Grid.Row="3" Background="{StaticResource ListBackground}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ID editor -->
        <Border Grid.Column="0" IsEnabled="{Binding HasSelection}" BorderBrush="{StaticResource ControlBackground}" BorderThickness="0, 0, 3, 0">
          <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        Focusable="False">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=EditorScroll}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="3, 3, 3, 0">
                <Label Width="Auto" Target="{Binding ElementName=DetailHashBox}">
                  <Label.Content>
                    <StackPanel Orientation="Horizontal">
                      <Image Margin="0, 1, 5, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/tag_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz24.png"
                          RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock Foreground="{StaticResource FontColor}" Text="Hash: "/>
                    </StackPanel>
                  </Label.Content>
                </Label>
                <TextBox x:Name="DetailHashBox" Padding="2.5" Margin="2" Width="Auto"
                       BorderThickness="1"
                       Text="{Binding SelectedRow.HashHex, Mode=OneWay}" d:Text="F1A88E2"
                       AutoWordSelection="False"
                       VerticalScrollBarVisibility="Disabled"
                       HorizontalScrollBarVisibility="Disabled"
                       IsReadOnly="True"
                       FontFamily="Consolas, monospace"
                       />
              </WrapPanel>

              <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="3, 0, 3, 0">
                <Label Width="Auto" Target="{Binding ElementName=DetailIdBox}">
                  <Label.Content>
                    <StackPanel Orientation="Horizontal">
                      <Image Margin="0, 1, 5, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/label_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz24.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock Foreground="{StaticResource FontColor}" Text="ID: "/>
                    </StackPanel>
                  </Label.Content>
                </Label>
                <TextBox x:Name="DetailIdBox" Padding="2.5" Margin="2" Width="Auto" MinWidth="100" Height="Auto" MaxHeight="100"
                       BorderThickness="1"
                       Text="{Binding DetailId, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsTab="False"
                       AcceptsReturn="False"
                       AutoWordSelection="False"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       TextWrapping="Wrap"/>
              </WrapPanel>

              <Grid Grid.Row="3" Margin="3, 0, 3, 3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">
                  <Label.Content>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0, 1, 5, 0" Text="&#xE7B3;"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock>
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontWeight" Value="Regular"/>
                            <Setter Property="Text" Value="Current String Value: "/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelectedStringModified}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Text" Value="Current String Value*: "/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Label.Content>
                </Label>

                <!-- This also works as ModifyStringWindow's status label -->
                <TextBlock Grid.Column="1" Padding="0, 5, 3, 5"
                         Text="{Binding StringPreview, Mode=OneWay}" d:Text="Test Longgggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg"
                         Foreground="{StaticResource FontColor}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>

              <!-- Collapse when nothing modified -->
              <Grid Grid.Row="4" Visibility="{Binding DetailIsDirty, Converter={StaticResource BoolToVis}}" Margin="3, -3, 3, 3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Only shown when there is a reason Confirm is disabled. -->
                <TextBlock Grid.Column="0" Margin="5"
                         Text="{Binding DetailStatus}" TextWrapping="WrapWithOverflow" Foreground="{StaticResource FontColor}"
                         d:Text="You cannot modify because the ID does not match the Hash.">
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CanConfirmDetail}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <TextBlock DockPanel.Dock="Left" Margin="0, 3, 5, 0" Text="&#xE946;" VerticalAlignment="Top"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                </TextBlock>
                <Button Grid.Column="1" Padding="6, 3, 6, 3" Margin="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="Auto"
                      Command="{Binding ConfirmDetailCommand}">
                  <Button.Content>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0, 1, 5, 0" Text="&#xE73E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                      <AccessText Foreground="{StaticResource FontColor}" Text="Con_firm"/>
                    </StackPanel>
                  </Button.Content>
                </Button>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Right" Width="3" Background="{StaticResource ControlBackground}"/>

        <!-- Assets referencing the selected string -->
        <Border Grid.Column="1" BorderBrush="{StaticResource ControlBackground}" BorderThickness="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" IsEnabled="{Binding HasSelection}">
              <Label DockPanel.Dock="Left" Margin="0, 0, 0, 3">
                <Label.Content>
                  <StackPanel Orientation="Horizontal">
                    <Image Margin="0, 1, 5, 0" Width="14" Source="/FsLocalizationPlugin;component/Images/quick_reference_all_32dp_FFFFFF_FILL0_wght600_GRAD-25_opsz40.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Foreground="{StaticResource FontColor}" Text="{Binding ReferencesHeader}" d:Text="14 References:"/>
                  </StackPanel>
                </Label.Content>
              </Label>
              <WrapPanel DockPanel.Dock="Right">
                <ToggleButton x:Name="AddRefToggleButton" Padding="6, 3, 6, 3" Margin="0, 3, 3, 3">
                  <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                          <!-- ToggleButton.Style cannot be overwritten -->
                          <DataTrigger Binding="{Binding IsChecked, ElementName=AddRefToggleButton}" Value="True">
                            <Setter Property="Margin" Value="-1"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyCore;component/Images/Add.png"
           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <AccessText Foreground="{StaticResource FontColor}" Text="A_dd"/>
                  </StackPanel>
                </ToggleButton>

                <Popup x:Name="AddRefPopup" Height="500" Width="300" KeyDown="Popup_KeyDown"
                       IsOpen="{Binding IsChecked, ElementName=AddRefToggleButton}" StaysOpen="False" d:IsOpen="True"
                       Placement="Top" PlacementTarget="{Binding ElementName=AddRefToggleButton}"
                       AllowsTransparency="True" PopupAnimation="Slide"
                       Opened="AddRefPopup_Opened">
                  <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource ControlBackground}" BorderThickness="2" RenderOptions.EdgeMode="Aliased">
                    <core:FrostyDataExplorer x:Name="RefExplorer" AutomationProperties.Name="Pick an asset to reference" ToolbarVisible="False" Margin="0, 2, 0, 0" InitialHeight="2*"/>
                  </Border>
                </Popup>

                <Button Padding="6, 3, 6, 3" Margin="0, 3, 3, 3"
                        Click="RemoveRef_Click" IsEnabled="{Binding HasRefSelection}">
                  <StackPanel Orientation="Horizontal">
                    <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Remove.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <AccessText Foreground="{StaticResource FontColor}" Text="Re_move"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </DockPanel>
            <!-- FrostyAssetListView shows white background when disabled, keep it enabled -->
            <core:FrostyAssetListView Grid.Row="1" x:Name="RefsList" AutomationProperties.Name="References" Margin="0, -2, 0, 0" SelectedAssetDoubleClick="RefsList_SelectedAssetDoubleClick"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{StaticResource ListBackground}"
                                      ItemsSource="{Binding SelectedReferences}" VirtualizingPanel.ScrollUnit="Pixel">
              <core:FrostyAssetListView.AssetContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open Asset" Click="RefsList_SelectedAssetDoubleClick">
                    <MenuItem.Icon>
                      <Image Source="/FrostyEditor;component/Images/OpenAsset.png"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Find in Data Explorer" Click="RefsList_FindAsset_Click">
                    <MenuItem.Icon>
                      <Image Source="/FrostyEditor;component/Images/Open.png"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                    </MenuItem.Icon>
                  </MenuItem>

                  <Separator/>
                  <MenuItem Header="Remove" Click="RemoveRef_Click"
                            IsEnabled="{Binding HasRefSelection}">
                    <MenuItem.Icon>
                      <Image Source="/FrostyEditor;component/Images/Remove.png"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </core:FrostyAssetListView.AssetContextMenu>
            </core:FrostyAssetListView>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
