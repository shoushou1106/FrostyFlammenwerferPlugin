<local:FlammenwerferWindowBase x:Class="FsLocalizationPlugin.Windows.OnboardingWindow"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:local="clr-namespace:FsLocalizationPlugin.Windows"
                               mc:Ignorable="d"
                               UseLayoutRounding="True"
                               ResizeMode="NoResize"
                               ShowInTaskbar="False"
                               Width="660" Height="580"
                               FontFamily="Segoe UI Variable Text, Global User Interface">
  <!-- View model: ViewModels/OnboardingViewModel.cs.
       Shown by Actions/OnboardingStartupAction.cs. -->

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/FsLocalizationPlugin;component/Themes/Generic.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis"/>

      <!-- The plugin's accent, used the way Frosty uses colour: rarely, and to mean something. -->
      <SolidColorBrush x:Key="Flame" Color="#FFF08A3C"/>
      <SolidColorBrush x:Key="Muted" Color="#FF8A8A8A"/>

      <CubicEase x:Key="Settle" EasingMode="EaseOut"/>
      <BackEase x:Key="Overshoot" EasingMode="EaseOut" Amplitude="0.4"/>

      <!-- ================= Storyboards =================
           They live here rather than in the scenes because a DataTemplate's EventTrigger on
           Loaded does not fire when a loaded ContentControl swaps templates, which froze every
           scene after the first on its opening frame. Started from code behind with
           Begin(this, true), so target names resolve in the window's namescope and a scene can be
           replayed. Every animation states its From for the same reason. -->

      <Storyboard x:Key="AnimLogo">
        <DoubleAnimation Storyboard.TargetName="LogoBox" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.35"/>
        <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                         From="0.9" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource Overshoot}"/>
        <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                         From="0.9" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource Overshoot}"/>
      </Storyboard>

      <Storyboard x:Key="AnimMenu">
        <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetName="MenuCursorT" Storyboard.TargetProperty="X"
                         From="190" To="122" BeginTime="0:0:0.2" Duration="0:0:0.6" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="MenuCursorT" Storyboard.TargetProperty="Y"
                         From="120" To="40" BeginTime="0:0:0.2" Duration="0:0:0.6" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="MenuChip" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.75" Duration="0:0:0.2"/>
        <ColorAnimation Storyboard.TargetName="MenuToolsBrush" Storyboard.TargetProperty="Color"
                        From="#FF8A8A8A" To="#FF1E1E1E" BeginTime="0:0:0.75" Duration="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetName="MenuDrop" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.85" Duration="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetName="MenuDropScale" Storyboard.TargetProperty="ScaleY"
                         From="0.55" To="1" BeginTime="0:0:0.85" Duration="0:0:0.3" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="MenuR1" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.05" Duration="0:0:0.22"/>
        <DoubleAnimation Storyboard.TargetName="MenuR2" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.17" Duration="0:0:0.22"/>
        <DoubleAnimation Storyboard.TargetName="MenuR3" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.29" Duration="0:0:0.22"/>
        <DoubleAnimation Storyboard.TargetName="MenuR4" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.41" Duration="0:0:0.22"/>
      </Storyboard>

      <Storyboard x:Key="AnimGlyphs">
        <DoubleAnimation Storyboard.TargetName="GlyphMissing" Storyboard.TargetProperty="Opacity"
                         From="1" To="0" BeginTime="0:0:0.6" Duration="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetName="GlyphAdded" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.7" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="GlyphAddedT" Storyboard.TargetProperty="Y"
                         From="-22" To="0" BeginTime="0:0:0.7" Duration="0:0:0.5" EasingFunction="{StaticResource Overshoot}"/>
        <ColorAnimation Storyboard.TargetName="GlyphSlotBrush" Storyboard.TargetProperty="Color"
                        From="#FF8A8A8A" To="#FFF08A3C" BeginTime="0:0:0.8" Duration="0:0:0.35"/>
        <DoubleAnimation Storyboard.TargetName="GlyphBarScale" Storyboard.TargetProperty="ScaleY"
                         From="0" To="1" BeginTime="0:0:1.05" Duration="0:0:0.45" EasingFunction="{StaticResource Overshoot}"/>
      </Storyboard>

      <Storyboard x:Key="AnimIds">
        <DoubleAnimation Storyboard.TargetName="IdSweep" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.3" Duration="0:0:0.15"/>
        <DoubleAnimation Storyboard.TargetName="IdSweepT" Storyboard.TargetProperty="X"
                         From="0" To="196" BeginTime="0:0:0.3" Duration="0:0:0.75" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="IdSweep" Storyboard.TargetProperty="Opacity"
                         From="1" To="0" BeginTime="0:0:1.0" Duration="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetName="IdHash" Storyboard.TargetProperty="Opacity"
                         From="1" To="0" BeginTime="0:0:0.75" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="IdHashT" Storyboard.TargetProperty="Y"
                         From="0" To="-18" BeginTime="0:0:0.75" Duration="0:0:0.4" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="IdName" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.85" Duration="0:0:0.35"/>
        <DoubleAnimation Storyboard.TargetName="IdNameT" Storyboard.TargetProperty="Y"
                         From="20" To="0" BeginTime="0:0:0.85" Duration="0:0:0.5" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="IdValue" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.1" Duration="0:0:0.35"/>
      </Storyboard>

      <Storyboard x:Key="AnimShare">
        <DoubleAnimation Storyboard.TargetName="ShareMine" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="ShareTheirs" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="SharePacket" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.6" Duration="0:0:0.15"/>
        <DoubleAnimation Storyboard.TargetName="SharePacketT" Storyboard.TargetProperty="X"
                         From="0" To="86" BeginTime="0:0:0.6" Duration="0:0:0.7" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="SharePacket" Storyboard.TargetProperty="Opacity"
                         From="1" To="0" BeginTime="0:0:1.2" Duration="0:0:0.15"/>
        <DoubleAnimation Storyboard.TargetName="ShareTick" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.25" Duration="0:0:0.25"/>
        <DoubleAnimation Storyboard.TargetName="ShareTickScale" Storyboard.TargetProperty="ScaleX"
                         From="0.4" To="1" BeginTime="0:0:1.25" Duration="0:0:0.45" EasingFunction="{StaticResource Overshoot}"/>
        <DoubleAnimation Storyboard.TargetName="ShareTickScale" Storyboard.TargetProperty="ScaleY"
                         From="0.4" To="1" BeginTime="0:0:1.25" Duration="0:0:0.45" EasingFunction="{StaticResource Overshoot}"/>
      </Storyboard>

      <Storyboard x:Key="AnimApply">
        <DoubleAnimation Storyboard.TargetName="ApplyMod" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="ApplyArrow" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.4" Duration="0:0:0.25"/>
        <DoubleAnimation Storyboard.TargetName="ApplyArrowT" Storyboard.TargetProperty="X"
                         From="-14" To="0" BeginTime="0:0:0.4" Duration="0:0:0.5" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="ApplyGame" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:0.75" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="ApplyTextT" Storyboard.TargetProperty="Y"
                         From="10" To="0" BeginTime="0:0:1.0" Duration="0:0:0.45" EasingFunction="{StaticResource Settle}"/>
        <DoubleAnimation Storyboard.TargetName="ApplyText" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" BeginTime="0:0:1.0" Duration="0:0:0.35"/>
      </Storyboard>

      <!-- Page indicator dot. Square, like everything else in Frosty. -->
      <DataTemplate x:Key="DotTemplate">
        <Border Width="16" Height="3" Margin="3,0">
          <Border.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Flame}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource ControlBackground}">
    <Grid Margin="2" Background="{StaticResource ListBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- The page. Slides and fades as a whole when the page changes. -->
      <Grid x:Name="PageHost" Grid.Row="0" Margin="40,26,40,0" Opacity="0" d:Opacity="1">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="PageShift"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="216"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Every scene lives here at once and only one is ever visible. Named elements in the
             window's own namescope is what lets the storyboards above reach them. -->
        <Grid Grid.Row="0">

          <!-- ===== Logo, a placeholder until the real animated mark exists ===== -->
          <Border x:Name="LogoBox" Visibility="Collapsed" Width="260" Height="120"
                  Background="{StaticResource ControlBackground}"
                  BorderBrush="{StaticResource Flame}" BorderThickness="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="LogoScale"/>
            </Border.RenderTransform>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                         Foreground="{StaticResource Flame}" HorizontalAlignment="Center"/>
              <TextBlock Text="Placeholder for Logo" Margin="0,8,0,0" FontSize="12"
                         Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- ===== Frosty's own menu, rebuilt from Frosty's own parts ===== -->
          <Viewbox x:Name="SceneMenuBox" Visibility="Collapsed">
            <Canvas Width="360" Height="200" Background="Transparent">
              <Border Canvas.Left="40" Canvas.Top="24" Width="280" Height="152"
                      Background="{StaticResource ListBackground}"
                      BorderBrush="{StaticResource ControlBackground}" BorderThickness="1"/>
              <Border Canvas.Left="41" Canvas.Top="25" Width="278" Height="24"
                      Background="{StaticResource ControlBackground}"/>

              <TextBlock Canvas.Left="52" Canvas.Top="30" Text="File" FontSize="10" Foreground="{StaticResource Muted}"/>
              <TextBlock Canvas.Left="76" Canvas.Top="30" Text="Edit" FontSize="10" Foreground="{StaticResource Muted}"/>
              <Border x:Name="MenuChip" Canvas.Left="100" Canvas.Top="27" Width="36" Height="20"
                      Background="{StaticResource Flame}" Opacity="0"/>
              <TextBlock x:Name="MenuTools" Canvas.Left="106" Canvas.Top="30" Text="Tools" FontSize="10">
                <TextBlock.Foreground>
                  <SolidColorBrush x:Name="MenuToolsBrush" Color="#FF8A8A8A"/>
                </TextBlock.Foreground>
              </TextBlock>

              <Border x:Name="MenuDrop" Canvas.Left="100" Canvas.Top="47" Width="164" Height="104"
                      Background="{StaticResource WindowBackground}"
                      BorderBrush="{StaticResource ControlBackground}" BorderThickness="1"
                      Opacity="0" RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="MenuDropScale" ScaleY="0.55"/>
                </Border.RenderTransform>
              </Border>

              <StackPanel x:Name="MenuR1" Canvas.Left="106" Canvas.Top="53" Opacity="0" Orientation="Horizontal">
                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                           Foreground="{StaticResource Flame}" Margin="0,1,6,0"/>
                <TextBlock Text="Modify String" FontSize="9" Foreground="{StaticResource FontColor}"/>
              </StackPanel>
              <StackPanel x:Name="MenuR2" Canvas.Left="106" Canvas.Top="75" Opacity="0" Orientation="Horizontal">
                <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                           Foreground="{StaticResource Flame}" Margin="0,1,6,0"/>
                <TextBlock Text="Modify Multiple Strings" FontSize="9" Foreground="{StaticResource FontColor}"/>
              </StackPanel>
              <StackPanel x:Name="MenuR3" Canvas.Left="106" Canvas.Top="97" Opacity="0" Orientation="Horizontal">
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                           Foreground="{StaticResource Flame}" Margin="0,1,6,0"/>
                <TextBlock Text="ID Database" FontSize="9" Foreground="{StaticResource FontColor}"/>
              </StackPanel>
              <StackPanel x:Name="MenuR4" Canvas.Left="106" Canvas.Top="119" Opacity="0" Orientation="Horizontal">
                <TextBlock Text="&#xE930;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                           Foreground="{StaticResource Flame}" Margin="0,1,6,0"/>
                <TextBlock Text="Check Compatibility" FontSize="9" Foreground="{StaticResource FontColor}"/>
              </StackPanel>

              <Path x:Name="MenuCursor" Fill="{StaticResource FontColor}" Opacity="0"
                    Data="M0,0 L0,14 L4,10.5 L6.5,16 L9,15 L6.5,9.5 L11,9 Z"
                    Stroke="#FF1E1E1E" StrokeThickness="0.6">
                <Path.RenderTransform>
                  <TranslateTransform x:Name="MenuCursorT" X="190" Y="120"/>
                </Path.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>

          <!-- ===== Glyphs and the character table ===== -->
          <Viewbox x:Name="SceneGlyphsBox" Visibility="Collapsed">
            <Canvas Width="360" Height="200" Background="Transparent">
              <Border Canvas.Left="66" Canvas.Top="40" Width="44" Height="44" Background="{StaticResource ControlBackground}"/>
              <TextBlock Canvas.Left="80" Canvas.Top="46" Text="A" FontSize="24" Foreground="{StaticResource FontColor}"/>
              <Border Canvas.Left="118" Canvas.Top="40" Width="44" Height="44" Background="{StaticResource ControlBackground}"/>
              <TextBlock Canvas.Left="132" Canvas.Top="46" Text="B" FontSize="24" Foreground="{StaticResource FontColor}"/>
              <Border Canvas.Left="170" Canvas.Top="40" Width="44" Height="44" Background="{StaticResource ControlBackground}"/>
              <TextBlock Canvas.Left="184" Canvas.Top="46" Text="C" FontSize="24" Foreground="{StaticResource FontColor}"/>

              <Border x:Name="GlyphSlot" Canvas.Left="222" Canvas.Top="40" Width="44" Height="44"
                      Background="Transparent" BorderThickness="1">
                <Border.BorderBrush>
                  <SolidColorBrush x:Name="GlyphSlotBrush" Color="#FF8A8A8A"/>
                </Border.BorderBrush>
              </Border>
              <TextBlock x:Name="GlyphMissing" Canvas.Left="238" Canvas.Top="46" Text="?" FontSize="24"
                         Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="GlyphAdded" Canvas.Left="232" Canvas.Top="44" Text="&#x6F22;" FontSize="24" Opacity="0"
                         Foreground="{StaticResource Flame}"
                         FontFamily="Microsoft YaHei UI, Segoe UI, Global User Interface">
                <TextBlock.RenderTransform>
                  <TranslateTransform x:Name="GlyphAddedT" Y="-22"/>
                </TextBlock.RenderTransform>
              </TextBlock>

              <TextBlock x:Name="GlyphTableLabel" Canvas.Left="66" Canvas.Top="106" Text="histogram" FontSize="9"
                         Foreground="{StaticResource Muted}"/>
              <Rectangle Canvas.Left="66" Canvas.Top="124" Width="10" Height="26" Fill="{StaticResource ControlBackground}"/>
              <Rectangle Canvas.Left="82" Canvas.Top="130" Width="10" Height="20" Fill="{StaticResource ControlBackground}"/>
              <Rectangle Canvas.Left="98" Canvas.Top="120" Width="10" Height="30" Fill="{StaticResource ControlBackground}"/>
              <Rectangle Canvas.Left="114" Canvas.Top="134" Width="10" Height="16" Fill="{StaticResource ControlBackground}"/>
              <Rectangle Canvas.Left="130" Canvas.Top="126" Width="10" Height="24" Fill="{StaticResource ControlBackground}"/>
              <Rectangle Canvas.Left="146" Canvas.Top="132" Width="10" Height="18" Fill="{StaticResource ControlBackground}"/>
              <Rectangle x:Name="GlyphBar" Canvas.Left="162" Canvas.Top="122" Width="10" Height="28"
                         Fill="{StaticResource Flame}" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform>
                  <ScaleTransform x:Name="GlyphBarScale" ScaleY="0"/>
                </Rectangle.RenderTransform>
              </Rectangle>
            </Canvas>
          </Viewbox>

          <!-- ===== Hash to ID ===== -->
          <Viewbox x:Name="SceneIdsBox" Visibility="Collapsed">
            <Canvas Width="360" Height="200" Background="Transparent">
              <Border Canvas.Left="60" Canvas.Top="52" Width="240" Height="92"
                      Background="{StaticResource ControlBackground}"
                      BorderBrush="{StaticResource WindowBackground}" BorderThickness="1"/>
              <TextBlock Canvas.Left="76" Canvas.Top="66" Text="string" FontSize="9" Foreground="{StaticResource Muted}"/>

              <TextBlock x:Name="IdHash" Canvas.Left="76" Canvas.Top="82" Text="A1B2C3D4" FontSize="20"
                         FontFamily="Consolas, monospace" Foreground="{StaticResource FontColor}">
                <TextBlock.RenderTransform><TranslateTransform x:Name="IdHashT"/></TextBlock.RenderTransform>
              </TextBlock>
              <TextBlock x:Name="IdName" Canvas.Left="76" Canvas.Top="82" Text="ID_MENU_START" FontSize="20" Opacity="0"
                         FontFamily="Consolas, monospace" Foreground="{StaticResource Flame}">
                <TextBlock.RenderTransform><TranslateTransform x:Name="IdNameT" Y="20"/></TextBlock.RenderTransform>
              </TextBlock>
              <TextBlock x:Name="IdValue" Canvas.Left="76" Canvas.Top="110" Text="&quot;Start Game&quot;" FontSize="11" Opacity="0"
                         Foreground="{StaticResource Muted}"/>

              <Rectangle x:Name="IdSweep" Canvas.Left="60" Canvas.Top="52" Width="44" Height="92" Opacity="0">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00F08A3C" Offset="0"/>
                    <GradientStop Color="#4DF08A3C" Offset="0.5"/>
                    <GradientStop Color="#00F08A3C" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform><TranslateTransform x:Name="IdSweepT"/></Rectangle.RenderTransform>
              </Rectangle>
            </Canvas>
          </Viewbox>

          <!-- ===== Sharing ===== -->
          <Viewbox x:Name="SceneShareBox" Visibility="Collapsed">
            <Canvas Width="360" Height="200" Background="Transparent">
              <Border x:Name="ShareMine" Canvas.Left="42" Canvas.Top="62" Width="104" Height="76" Opacity="0"
                      Background="{StaticResource ControlBackground}"/>
              <TextBlock Canvas.Left="42" Canvas.Top="90" Width="104" TextAlignment="Center" Text=".fbmod" FontSize="13"
                         FontFamily="Consolas, monospace" Foreground="{StaticResource FontColor}"
                         Opacity="{Binding Opacity, ElementName=ShareMine}"/>

              <Path Canvas.Left="152" Canvas.Top="99" Data="M0,1 L56,1" Stroke="{StaticResource ControlBackground}"
                    StrokeThickness="2" StrokeDashArray="3 3"/>
              <Rectangle x:Name="SharePacket" Canvas.Left="150" Canvas.Top="96" Width="8" Height="8"
                         Fill="{StaticResource Flame}" Opacity="0">
                <Rectangle.RenderTransform><TranslateTransform x:Name="SharePacketT"/></Rectangle.RenderTransform>
              </Rectangle>

              <Border x:Name="ShareTheirs" Canvas.Left="214" Canvas.Top="62" Width="104" Height="76" Opacity="0"
                      Background="{StaticResource ControlBackground}"/>
              <StackPanel Canvas.Left="214" Canvas.Top="82" Width="104" Opacity="{Binding Opacity, ElementName=ShareTheirs}">
                <TextBlock Text="any Frosty" FontSize="11" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="any plugin" FontSize="11" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
              </StackPanel>

              <Border x:Name="ShareTick" Canvas.Left="298" Canvas.Top="54" Width="24" Height="24" Opacity="0"
                      Background="{StaticResource Flame}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="ShareTickScale" ScaleX="0.4" ScaleY="0.4"/>
                </Border.RenderTransform>
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                           Foreground="#FF1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Canvas>
          </Viewbox>

          <!-- ===== Mod Manager: install, launch, read it in your language ===== -->
          <Viewbox x:Name="SceneApplyBox" Visibility="Collapsed">
            <Canvas Width="360" Height="200" Background="Transparent">
              <Border x:Name="ApplyMod" Canvas.Left="34" Canvas.Top="56" Width="98" Height="66" Opacity="0"
                      Background="{StaticResource ControlBackground}"/>
              <TextBlock Canvas.Left="34" Canvas.Top="80" Width="98" TextAlignment="Center" Text=".fbmod" FontSize="12"
                         FontFamily="Consolas, monospace" Foreground="{StaticResource FontColor}"
                         Opacity="{Binding Opacity, ElementName=ApplyMod}"/>

              <TextBlock x:Name="ApplyArrow" Canvas.Left="142" Canvas.Top="78" Text="&#xE72A;" Opacity="0"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                         Foreground="{StaticResource Flame}">
                <TextBlock.RenderTransform><TranslateTransform x:Name="ApplyArrowT" X="-14"/></TextBlock.RenderTransform>
              </TextBlock>

              <Border x:Name="ApplyGame" Canvas.Left="188" Canvas.Top="44" Width="138" Height="90" Opacity="0"
                      Background="{StaticResource ControlBackground}"/>
              <TextBlock Canvas.Left="188" Canvas.Top="54" Width="138" TextAlignment="Center" Text="your game" FontSize="9"
                         Foreground="{StaticResource Muted}" Opacity="{Binding Opacity, ElementName=ApplyGame}"/>
              <TextBlock x:Name="ApplyText" Canvas.Left="188" Canvas.Top="82" Width="138" TextAlignment="Center"
                         Text="&#x5F00;&#x59CB;&#x6E38;&#x620F;" FontSize="18" Opacity="0"
                         Foreground="{StaticResource Flame}"
                         FontFamily="Microsoft YaHei UI, Segoe UI, Global User Interface">
                <TextBlock.RenderTransform><TranslateTransform x:Name="ApplyTextT" Y="10"/></TextBlock.RenderTransform>
              </TextBlock>
            </Canvas>
          </Viewbox>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Current.Title}" Margin="0,2,0,0"
                   FontFamily="Segoe UI Variable Display, Segoe UI, Global User Interface"
                   FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource FontColor}"
                   d:Text="Flammenwerfer is installed"/>

        <TextBlock Grid.Row="2" Text="{Binding Current.Body}" Margin="14,12,14,0"
                   FontSize="13.5" LineHeight="20" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource FontColor}" Opacity="0.8"
                   d:Text="It replaces FsLocalizationPlugin and edits the text your game shows on screen."/>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Current.Bullets}" Margin="30,14,30,0"
                      Visibility="{Binding Current.HasBullets, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="4" Height="4" Margin="4,8,10,0" VerticalAlignment="Top"
                        Background="{StaticResource Flame}"/>
                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource FontColor}" Opacity="0.8"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The "where to find it" line, as an island the way the ID Database toolbar does it. -->
        <Border Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{StaticResource ControlBackground}" Padding="10,5,10,5"
                Visibility="{Binding Current.HasHint, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding Current.Hint}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{StaticResource FontColor}" Opacity="0.65"
                     d:Text="Tools &#x203A; Flammenwerfer"/>
        </Border>
      </Grid>

      <!-- Controls. Fixed, so they never move as the page changes. -->
      <Border Grid.Row="1" Background="{StaticResource ControlBackground}" Margin="1,0,1,1" Padding="10,8,10,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Padding="10,4,10,4" MinWidth="88" Command="{Binding BackCommand}"
                  Visibility="{Binding ShowDots, Converter={StaticResource BoolToVis}}">
            <AccessText Foreground="{StaticResource FontColor}" Text="_Back"/>
          </Button>

          <Button Grid.Column="0" Padding="10,4,10,4" MinWidth="110" Command="{Binding TourCommand}"
                  Visibility="{Binding IsWhatsNew, Converter={StaticResource BoolToVis}}">
            <AccessText Foreground="{StaticResource FontColor}" Text="Take the _tour"/>
          </Button>

          <ItemsControl Grid.Column="1" ItemsSource="{Binding Dots}" ItemTemplate="{StaticResource DotTemplate}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowDots, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <Button Grid.Column="2" Padding="10,4,10,4" MinWidth="120" Command="{Binding NextCommand}" IsDefault="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding NextText}" Foreground="{StaticResource FontColor}" d:Text="Continue"/>
              <TextBlock Text="&#xE76C;" Margin="7,1,0,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="11" Foreground="{StaticResource Flame}"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</local:FlammenwerferWindowBase>
