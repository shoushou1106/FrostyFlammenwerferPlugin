<local:FlammenwerferWindowBase x:Class="FsLocalizationPlugin.Windows.ModifyMultipleStringsWindow"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:local="clr-namespace:FsLocalizationPlugin.Windows"
                               xmlns:core="clr-namespace:Frosty.Core;assembly=FrostyCore"
                               xmlns:fdev="FrostyDeveloper"
                               mc:Ignorable="d"
                               UseLayoutRounding="True"
                               Title="Modify Multiple Strings - Flammenwerfer" SizeToContent="Height" MaxHeight="850" Width="400"
                               FontFamily="Segoe UI Variable Text, Global User Interface">

  <!-- View model: ViewModels/ModifyMultipleStringsViewModel.cs -->

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ListBackground}"/>

    <Grid x:Name="MainGrid" Grid.Row="0" Margin="5, 10, 5, 10">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Target="{Binding ElementName=FilterTextBox}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0, 1, 5, 0" Text="&#xE721;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            <AccessText Foreground="{StaticResource FontColor}" Text="_Find: "/>
          </StackPanel>
        </Label>

        <TextBox x:Name="FilterTextBox" Grid.Row="1" Padding="2.5" Margin="5, 2, 5, 2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 BorderThickness="1"
                 Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 AcceptsReturn="True" AcceptsTab="True"/>
        <TextBlock Grid.Row="2" Margin="5, 2, 5, 0" Text="{Binding MatchSummary}" TextWrapping="WrapWithOverflow">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Foreground" Value="Red"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding PatternError}" Value="{x:Null}">
                  <Setter Property="Foreground" Value="{StaticResource FontColor}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <Grid Grid.Row="1" Margin="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Target="{Binding ElementName=EditTextBox}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0, 1, 5, 0" Text="&#xE932;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            <AccessText Foreground="{StaticResource FontColor}" Text="Rep_lace: "/>
          </StackPanel>
        </Label>
        <TextBox x:Name="EditTextBox" Grid.Row="1" Padding="2.5" Margin="5, 2, 5, 2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 BorderThickness="1"
                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 AcceptsReturn="True" AcceptsTab="True"/>
      </Grid>

      <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="3">
        <Label Target="{Binding ElementName=LanguageComboBox}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0, 1, 5, 0" Text="&#xF2B7;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            <AccessText Foreground="{StaticResource FontColor}" Text="_Language: "/>
          </StackPanel>
        </Label>
        <ComboBox x:Name="LanguageComboBox" MinWidth="140" Width="Auto" Margin="2"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}">
        </ComboBox>
      </WrapPanel>

      <StackPanel Grid.Row="3" Margin="3" Orientation="Vertical">
        <Label Width="Auto">
          <StackPanel Orientation="Horizontal">
            <Image Margin="0, 2, 5, 0" Width="14" Source="/FrostyCore;component/Images/Settings.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Foreground="{StaticResource FontColor}" Text="Options: "/>
          </StackPanel>
        </Label>

        <WrapPanel Orientation="Vertical" Margin="15, 0, 0, 0">

          <CheckBox Margin="3, 0, 3, 0" VerticalContentAlignment="Center"
                    IsChecked="{Binding CaseSensitive}" Cursor="Hand">
            <CheckBox.Style>
              <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="IsEnabled" Value="True"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseRegex}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </CheckBox.Style>
            <Label>
              <Label.Content>
                <StackPanel Orientation="Horizontal">
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Case sensitive"/>
                </StackPanel>
              </Label.Content>
            </Label>
          </CheckBox>

          <CheckBox Margin="3, 0, 3, 0" VerticalContentAlignment="Center"
                    IsChecked="{Binding MatchWholeWord}" Cursor="Hand">
            <CheckBox.Style>
              <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="IsEnabled" Value="True"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseRegex}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </CheckBox.Style>
            <Label>
              <StackPanel Orientation="Horizontal">
                <AccessText Foreground="{StaticResource FontColor}" Text="Match _whole word"/>
              </StackPanel>
            </Label>
          </CheckBox>

          <CheckBox Margin="3, 0, 3, 0" VerticalContentAlignment="Center"
                    IsChecked="{Binding UseRegex}" Cursor="Hand">
            <Label>
              <StackPanel Orientation="Horizontal">
                <AccessText Foreground="{StaticResource FontColor}" Text="_Use regular expressions"/>
              </StackPanel>
            </Label>
          </CheckBox>

          <CheckBox Margin="3, 0, 3, 0" VerticalContentAlignment="Center"
                    IsChecked="{Binding ReplaceEntireString}" Cursor="Hand">
            <Label>
              <StackPanel Orientation="Horizontal">
                <AccessText Foreground="{StaticResource FontColor}" Text="Replace _entire string"/>
              </StackPanel>
            </Label>
          </CheckBox>
        </WrapPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="5">
      <DockPanel LastChildFill="False">
        <Button x:Name="CancelButton" Padding="6, 3, 6, 3" Margin="3" DockPanel.Dock="Left" Width="Auto" Command="{Binding CancelCommand}" IsCancel="True">
          <Button.Content>
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0, 1, 5, 0" Text="&#xF3B1;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
              <AccessText Foreground="{StaticResource FontColor}" Text="E_xit"/>
            </StackPanel>
          </Button.Content>
        </Button>

        <WrapPanel DockPanel.Dock="Right">
          <Button x:Name="RevertButton" Padding="6, 3, 6, 3" Margin="3" Width="Auto"
                  Command="{Binding RevertCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Orientation="Horizontal">
              <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Revert.png"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <AccessText Foreground="{StaticResource FontColor}" Text="_Revert"/>
            </StackPanel>
          </Button>
          <Button x:Name="RemoveButton" Padding="6, 3, 6, 3" Margin="3" Width="Auto"
                  Command="{Binding RemoveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0, 1, 5, 0" Text="&#xE75C;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
              <AccessText Foreground="{StaticResource FontColor}" Text="Remo_ve"/>
            </StackPanel>
          </Button>
          <Button x:Name="ReplaceButton" Padding="6, 3, 6, 3" Margin="3" Width="Auto" IsDefault="True"
                  Command="{Binding ReplaceCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0, 1, 5, 0" Text="&#xE70F;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
              <AccessText Foreground="{StaticResource FontColor}" Text="Re_place"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>
    </Grid>
  </Grid>
</local:FlammenwerferWindowBase>
