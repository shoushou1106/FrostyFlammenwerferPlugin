<local:FlammenwerferWindowBase x:Class="FsLocalizationPlugin.Windows.ExportChunksWindow"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:local="clr-namespace:FsLocalizationPlugin.Windows"
                               xmlns:core="clr-namespace:Frosty.Core;assembly=FrostyCore"
                               xmlns:fdev="FrostyDeveloper"
                               mc:Ignorable="d"
                               UseLayoutRounding="True"
                               Title="Export Chunks to Files - Flammenwerfer" SizeToContent="Height" MaxHeight="850" Width="400"
                               FontFamily="Segoe UI Variable Text, Global User Interface">
  <!-- View model: ViewModels/ExportChunksViewModel.cs (+ ViewModels/LanguageExportOptions.cs) -->

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ListBackground}"/>
    <Label x:Name="NoModifiedLanguageFoundLabel" Grid.Row="0" Margin="5, 10, 5, 10">
      <Label.Style>
        <Style TargetType="{x:Type Label}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasModifiedLanguages}" Value="False">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Label.Style>
      <Label.Content>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="0, 1, 5, 0" Text="&#xE783;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Foreground="Red"/>
          <TextBlock Grid.Column="1" Foreground="Red" TextWrapping="WrapWithOverflow" Text="No modified language found. This window is designed to export modified strings."/>
        </Grid>
      </Label.Content>
    </Label>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="MainStackPanel" Margin="5, 10, 5, 10">
        <StackPanel.Style>
          <Style TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasModifiedLanguages}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Label Margin="3">
          <Label.Content>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Margin="0, 1, 5, 0" Text="&#xE946;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Grid.Column="1" TextWrapping="WrapWithOverflow" Text="Choose one or more modified language(s), and export at once."/>
            </Grid>
          </Label.Content>
        </Label>
        <WrapPanel Margin="3" Orientation="Horizontal">
          <Label Target="{Binding ElementName=LanguageComboBox}">
            <Label.Content>
              <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0, 1, 5, 0" Text="&#xF2B7;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                <AccessText Foreground="{StaticResource FontColor}" Text="Modified _Language: "/>
              </StackPanel>
            </Label.Content>
          </Label>
          <ComboBox x:Name="LanguageComboBox" MinWidth="140" Width="Auto" Margin="2"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguageOption}"
                    DisplayMemberPath="Language">
          </ComboBox>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" Margin="7, 3, 3, 3">
          <CheckBox VerticalAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"
                    IsChecked="{Binding SelectedLanguageOption.ExportBinary, Mode=TwoWay}">
            <Label>
              <StackPanel Orientation="Horizontal">
                <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Database.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                <AccessText Foreground="{StaticResource FontColor}" Text="Binary _Strings: "/>
              </StackPanel>
            </Label>
          </CheckBox>
          <Button Padding="6, 3, 6, 3" VerticalAlignment="Center" Width="Auto"
                    IsEnabled="{Binding SelectedLanguageOption.ExportBinary}"
                    Command="{Binding BrowseCommand}" CommandParameter="Binary">
            <StackPanel Orientation="Horizontal">
              <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Open.png"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              <AccessText Foreground="{StaticResource FontColor}" Text="_Browse"/>
            </StackPanel>
          </Button>
          <TextBox Padding="2.5" Margin="2, 0, 2, 0" Width="Auto" Height="Auto"
                   IsEnabled="{Binding SelectedLanguageOption.ExportBinary}"
                   BorderThickness="1"
                   Text="{Binding SelectedLanguageOption.BinaryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsTab="False"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   VerticalScrollBarVisibility="Disabled"
                   HorizontalScrollBarVisibility="Disabled"/>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" Margin="7, 3, 3, 3">
          <CheckBox VerticalAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"
                    IsChecked="{Binding SelectedLanguageOption.ExportHistogram, Mode=TwoWay}">
            <Label>
              <StackPanel Orientation="Horizontal">
                <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Grid.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                <AccessText Foreground="{StaticResource FontColor}" Text="_Histogram: "/>
              </StackPanel>
            </Label>
          </CheckBox>
          <Button Padding="6, 3, 6, 3" VerticalAlignment="Center" Width="Auto"
                  IsEnabled="{Binding SelectedLanguageOption.ExportHistogram}"
                  Command="{Binding BrowseCommand}" CommandParameter="Histogram">
            <Button.Content>
              <StackPanel Orientation="Horizontal">
                <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Open.png"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <AccessText Foreground="{StaticResource FontColor}" Text="Bro_wse"/>
              </StackPanel>
            </Button.Content>
          </Button>
          <TextBox Padding="2.5" Margin="2, 0, 2, 0" Width="Auto" Height="Auto"
                   IsEnabled="{Binding SelectedLanguageOption.ExportHistogram}"
                   BorderThickness="1"
                   Text="{Binding SelectedLanguageOption.HistogramPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsTab="False"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   VerticalScrollBarVisibility="Disabled"
                   HorizontalScrollBarVisibility="Disabled">
          </TextBox>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" Height="38">
      <Grid Margin="5">
        <DockPanel LastChildFill="False">
          <Button x:Name="CancelButton" Padding="6, 3, 6, 3" Margin="3" DockPanel.Dock="Left" Width="Auto" Command="{Binding CancelCommand}" IsCancel="True">
            <Button.Content>
              <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0, 1, 5, 0" Text="&#xF3B1;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                <AccessText Foreground="{StaticResource FontColor}" Text="_Cancel"/>
              </StackPanel>
            </Button.Content>
          </Button>
          <WrapPanel DockPanel.Dock="Right">
            <Button x:Name="StartOverButton" Padding="6, 3, 6, 3" Margin="3" DockPanel.Dock="Right" Width="Auto" Command="{Binding StartOverCommand}">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Margin="0, 1, 5, 0" Text="&#xe72c;"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="Start _Over"/>
                </StackPanel>
              </Button.Content>
            </Button>
            <Button x:Name="ConfirmButton" Padding="6, 3, 6, 3" Margin="3" Width="Auto" IsDefault="True"
                    Command="{Binding ExportCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <Image Margin="0, 1, 5, 0" Width="14" Source="/FrostyEditor;component/Images/Export.png"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <AccessText Foreground="{StaticResource FontColor}" Text="_Export"/>
                </StackPanel>
              </Button.Content>
            </Button>
          </WrapPanel>
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</local:FlammenwerferWindowBase>
